---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "silt — byte-exact git object ids, in pure Gleam",
  description = "A pure-Gleam library for content-addressed git objects with git-canonical SHA-1 ids, plus the response shapes for a git-compatible content-addressable storage REST API. Owns no store.",
} = Astro.props;

const repo = "https://github.com/tylerbutler/silt";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0e1b1c" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head">
      <div class="site-head__in shell">
        <a class="brand" href="/" aria-label="silt home">
          <span class="brand__mark" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </span>
          <span class="brand__word">silt</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <a
            href="/reference/object"
            aria-current={isActive("/reference/object") ? "page" : undefined}
            >object</a
          >
          <a
            href="/reference/rest"
            aria-current={isActive("/reference/rest") ? "page" : undefined}
            >rest</a
          >
          <a class="nav__ext" href={repo} rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <hr class="strata-divider" />
      <div class="site-foot__in shell">
        <div>
          <span class="foot-word">silt</span>
          <p>Byte-exact git object ids, in pure Gleam.</p>
        </div>
        <nav class="foot-nav" aria-label="Footer">
          <a href="/reference/object">silt/object</a>
          <a href="/reference/rest">silt/rest</a>
          <a href={repo} rel="noopener">Source ↗</a>
        </nav>
        <p class="foot-meta">
          MIT licensed · Pure Gleam · Part of the Fluid Framework family
        </p>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: var(--z-overlay);
        background: var(--silt);
        color: var(--bg-deep);
        padding: 0.6rem 1rem;
        border-radius: 0 0 var(--r-inset) 0;
        font-family: var(--font-mono);
        font-size: 0.85rem;
      }
      .skip:focus {
        left: 0;
      }

      .site-head {
        position: sticky;
        top: 0;
        z-index: var(--z-header);
        background: color-mix(in oklch, var(--bg) 92%, transparent);
        border-bottom: 1px solid var(--hairline-soft);
        backdrop-filter: blur(8px);
      }
      .site-head__in {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 4rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--ink);
      }
      .brand:hover {
        text-decoration: none;
      }
      .brand__word {
        font-size: 1.35rem;
        font-weight: 800;
        font-stretch: 120%;
        letter-spacing: -0.02em;
      }
      .brand__mark {
        display: inline-grid;
        gap: 2px;
        width: 20px;
      }
      .brand__mark span {
        height: 3px;
        border-radius: 1px;
        display: block;
      }
      .brand__mark span:nth-child(1) {
        background: var(--strata-2);
        width: 100%;
      }
      .brand__mark span:nth-child(2) {
        background: var(--strata-3);
        width: 80%;
      }
      .brand__mark span:nth-child(3) {
        background: var(--strata-4);
        width: 100%;
      }
      .brand__mark span:nth-child(4) {
        background: var(--strata-5);
        width: 65%;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: clamp(1rem, 3vw, 1.9rem);
        font-family: var(--font-mono);
        font-size: 0.9rem;
      }
      .nav a {
        color: var(--ink-muted);
      }
      .nav a:hover {
        color: var(--aqua);
        text-decoration: none;
      }
      .nav a[aria-current="page"] {
        color: var(--ink);
      }
      .nav__ext {
        color: var(--ink) !important;
      }

      .site-foot {
        margin-top: var(--section-gap);
      }
      .site-foot__in {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1.5rem 2rem;
        padding-top: 2.5rem;
        padding-bottom: 3.5rem;
        align-items: start;
      }
      .foot-word {
        font-weight: 800;
        font-stretch: 120%;
        font-size: 1.1rem;
      }
      .site-foot__in p {
        color: var(--ink-muted);
        font-size: 0.95rem;
        margin-top: 0.35rem;
      }
      .foot-nav {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        text-align: right;
      }
      .foot-meta {
        grid-column: 1 / -1;
        border-top: 1px solid var(--hairline-soft);
        padding-top: 1.25rem;
        color: var(--ink-faint) !important;
        font-family: var(--font-mono);
        font-size: 0.78rem;
      }
      @media (max-width: 34rem) {
        .site-foot__in {
          grid-template-columns: 1fr;
        }
        .foot-nav {
          text-align: left;
          flex-direction: row;
          flex-wrap: wrap;
          gap: 1rem;
        }
      }
    </style>

    <script>
      // Reveal — enhances already-visible content (hidden state only applies
      // under .js + no reduced-motion, per global.css).
      const reveals = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                obs.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add("is-in"));
      }
      // Safety net: never leave content hidden.
      window.addEventListener("load", () => {
        setTimeout(
          () => reveals.forEach((el) => el.classList.add("is-in")),
          1200,
        );
      });

      // Copy buttons.
      document.querySelectorAll(".copy").forEach((btn) => {
        btn.addEventListener("click", () => {
          const root = btn.closest(".codeblock, .install");
          const pre = root?.querySelector("pre");
          const text = pre?.innerText ?? "";
          navigator.clipboard?.writeText(text).then(() => {
            const label = btn.querySelector(".copy__text");
            const prev = label?.textContent;
            if (label) label.textContent = "copied";
            btn.setAttribute("data-copied", "true");
            setTimeout(() => {
              if (label) label.textContent = prev ?? "copy";
              btn.removeAttribute("data-copied");
            }, 1600);
          });
        });
      });

      // Hash resolve — scrambled hex settles to the real SHA-1.
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!reduce) {
        const hex = "0123456789abcdef";
        document.querySelectorAll("[data-hash]").forEach((el) => {
          const final = el.getAttribute("data-hash") || "";
          let frame = 0;
          const total = 26;
          const tick = () => {
            const locked = Math.floor((frame / total) * final.length);
            let out = "";
            for (let i = 0; i < final.length; i++) {
              out +=
                i < locked
                  ? final[i]
                  : hex[(Math.random() * hex.length) | 0];
            }
            el.textContent = out;
            frame++;
            if (frame <= total) {
              setTimeout(tick, 34);
            } else {
              el.textContent = final;
            }
          };
          // brief delay so it reads as "settling" after layers land
          setTimeout(tick, 700);
        });
      }
    </script>
  </body>
</html>
